# Shared password for the fraternity study-rooms intake API (gitignored).
INTAKE_PASSWORD=change-me
# Optional: sticky session signing key (random hex). Auto-generated if empty.
# INTAKE_SECRET=
INTAKE_HOST=0.0.0.0
INTAKE_PORT=8790

# Chapter site owns the UI at /academic/study-rooms and proxies
# /study-room-api/* → this API (see academic-board next.config.ts).
CHAPTER_SITE_URL=https://academic-board.vercel.app/academic

# Cookie flags apply to the *browser* origin (chapter site via proxy):
# Local Next.js (http://localhost:3000):
INTAKE_HTTPS=0
INTAKE_COOKIE_SAMESITE=lax
# Production Vercel (HTTPS) — set on the Mac when funneling for Vercel:
# INTAKE_HTTPS=1
# INTAKE_COOKIE_SAMESITE=lax
# INTAKE_PUBLIC_URL=https://your-mac.tailXXXX.ts.net

# Board Outlook account id used by outlook_watcher:
# OUTLOOK_SCRAPE_ACCOUNT=board
