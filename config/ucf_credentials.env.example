# Shared calendar / inbox for the Academic Board study room bot.
# Import LibCal cookies via intake site or ./import-cookies.sh (no UCF passwords).
# Patrons forward alerts@mail.libcal.com → BOOKING_EMAIL (board Outlook).
# Calendar: config/service-account.json + STUDY_ROOMS_CALENDAR_ID below.

BOOKING_EMAIL=jo564454@ucf.edu
# Nickname whose cookies can open this Outlook inbox (same person can also book):
# OUTLOOK_SCRAPE_ACCOUNT=Josh
STUDY_ROOMS_CALENDAR_NAME=Academic Board - Study Rooms
STUDY_ROOMS_CALENDAR_DESCRIPTION=Automated study room bookings
# Required for IAM service accounts (Calendar → Settings → Integrate calendar):
# STUDY_ROOMS_CALENDAR_ID=xxxxxxxx@group.calendar.google.com

# Optional folder (leave unset to scrape Inbox):
# OUTLOOK_STUDY_ROOM_FOLDER=

# Failure alerts (optional SMTP — Gmail App Password is fine)
ALERT_TO=thejoshperez@gmail.com
ALERT_ENABLED=1
# ALERT_SMTP_USER=thejoshperez@gmail.com
# ALERT_SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# ALERT_FROM=thejoshperez@gmail.com
# CHAPTER_SITE_URL=https://academic-board.vercel.app/academic

# Optional overrides
# DAYS_AHEAD=3
# GOOGLE_SERVICE_ACCOUNT_FILE=config/service-account.json
