# Copy to ucf_credentials.env and fill in. Never commit the real file.
#
# Per-person UCF logins do NOT go here — use ./add-account.sh, which writes
# accounts/<name>.env for each account.

# Google Calendar
BOOKING_EMAIL=you@gmail.com
STUDY_ROOMS_CALENDAR_NAME=Study Rooms
STUDY_ROOMS_CALENDAR_DESCRIPTION=Automated study room bookings

# Optional overrides
# DAYS_AHEAD=3
# USE_IMESSAGE_2FA=0
